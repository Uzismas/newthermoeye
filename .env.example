# Thermoeye environment variables
# Copy this file to .env.local and fill in your actual keys

# Optional external transport check. Not a validated segmentation/classification model.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# Optional: override the model used for the external transport check
# THERMOEYE_ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Optional Google Gemini transport provider (explicit opt-in only)
GOOGLE_API_KEY=

# Local endpoint defaults to loopback. Images remain local by default.
THERMOEYE_LOCAL_INFERENCE_URL=http://127.0.0.1:8000

# External image analysis is disabled by default. Set to true only after
# data-governance approval and an appropriate provider agreement.
THERMOEYE_ALLOW_EXTERNAL_VISION=false
# A request must also explicitly send allowExternal=true. UI never sends this automatically.
# Missing/broken ONNX artifacts return unavailable. Explicit research fallback only:
OCTA_SEGMENTATION_ENGINE=onnx_vessel_unet
# Use heuristic_research_baseline only for explicit research experiments.

# Optional stable high-entropy server secret for analysis-result receipts.
# Without it, a random process-local key is used and restart invalidates receipts.
# A stable key does not make the in-memory case store durable or multi-worker safe.
# THERMOEYE_ANALYSIS_SIGNING_KEY=

# Phase 3 approved-demo persistence is opt-in. Keep this path outside public/.
# THERMOEYE_DEMO_STORAGE_DIR=D:\\ThermoeyeData\\private-demo
# THERMOEYE_APPROVED_DEMO_CASE_IDS=TE-DEMO-01
